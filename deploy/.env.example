# Copy this file to deploy/.env on the server and fill in the values.
# deploy/.env is never committed.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user ids that are allowed to use the bot
ALLOWED_TELEGRAM_ID=

# --- Obsidian vault ---------------------------------------------------------
# Path of the vault on the host. The same folder is shared with Syncthing.
VAULT_HOST_PATH=/opt/obsidian-vault
# Inside the container the vault is always mounted at /vault.
OBSIDIAN_VAULT_PATH=/vault
TIMEZONE=Asia/Almaty

# --- Model provider ---------------------------------------------------------
# The OpenCode Go relay. The key is injected by the local proxy, the agent
# only talks to http://127.0.0.1:11434/v1 inside the container.
LLM_PROVIDER_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_PROXY_PORT=11434
# The model that turns a voice message into text, it has to accept audio
# parts. Empty means a voice message is stored as a file, as before.
TRANSCRIBE_MODEL=
TRANSCRIBE_TIMEOUT_MS=120000

# Health endpoint of the application on the host (only 127.0.0.1).
HEALTH_PORT=8090

# --- Mini App ----------------------------------------------------------------
# The port of the Mini App on the host. The app listens on the same container
# port as the health endpoint.
MINI_APP_PORT=8091
# The public https address of the Mini App. Telegram accepts only https, so
# the address comes from the tunnel (see deploy/tunnel.sh).
MINI_APP_URL=
# The token for the browser. Outside of Telegram there is no signed data, so
# the address of the app carries the token: https://<host>/?token=<token>
MINI_APP_TOKEN=

# --- Hermes Agent -----------------------------------------------------------
HERMES_MODEL=beam-free
HERMES_FALLBACK_MODEL=deepseek-v4.1-flash
HERMES_TIMEOUT_MS=300000
HERMES_MAX_TURNS=16

# --- Syncthing --------------------------------------------------------------
# The user id of the owner of the notes, the same as in the app container.
PUID=1000
PGID=1000
TZ=Asia/Almaty

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
BOT_ACK=⏳ Записываю в Obsidian...
